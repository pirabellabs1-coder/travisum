# Variables d'environnement Travisum
# À définir dans Vercel → Settings → Environment Variables (ne rien committer de réel).

# --- Assistant IA (OpenRouter) — fonction /api/chat ---
# Clé sk-or-… créée sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modèle OpenRouter (optionnel ; défaut : anthropic/claude-haiku-4.5)
CHAT_MODEL=anthropic/claude-haiku-4.5

# --- Prise de rendez-vous (Resend) — fonction /api/rdv ---
# Clé re_… créée sur https://resend.com/api-keys
RESEND_API_KEY=
# Destinataire des demandes de RDV (optionnel ; défaut : info@travisum.com)
RDV_TO=info@travisum.com
# Expéditeur (optionnel). Pour une bonne délivrabilité, vérifiez le domaine
# travisum.com dans Resend puis utilisez une adresse de ce domaine, ex. :
# RDV_FROM=Travisum <no-reply@travisum.com>
# Défaut de test (limité) : Travisum <onboarding@resend.dev>
RDV_FROM=Travisum <onboarding@resend.dev>
